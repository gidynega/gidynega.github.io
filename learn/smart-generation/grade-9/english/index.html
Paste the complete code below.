<style>
:root {
  --bg: #0b0b18;
  --card: #17172b;
  --pink: #ff55c8;
  --blue: #8187ff;
  --cyan: #65eee4;
  --text: #f5f5ff;
  --muted: #b9bad1;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

header {
  padding: 42px 18px;
  text-align: center;
  background: linear-gradient(135deg, #24133d, #102b46);
  border-bottom: 2px solid var(--cyan);
}

header h1 {
  color: var(--cyan);
  margin: 0 0 10px;
  font-size: clamp(26px, 5vw, 40px);
}

header p {
  max-width: 700px;
  margin: 8px auto;
  color: var(--muted);
}

.badge {
  display: inline-block;
  margin: 5px;
  padding: 6px 12px;
  border: 1px solid var(--pink);
  border-radius: 20px;
  color: var(--pink);
  font-size: 13px;
}

.container {
  width: min(1100px, 92%);
  margin: 28px auto;
}

.back {
  display: inline-block;
  color: var(--cyan);
  text-decoration: none;
  margin-bottom: 20px;
}

.back:hover { color: var(--pink); }

.intro {
  background: var(--card);
  padding: 22px;
  border-radius: 16px;
  border-left: 4px solid var(--pink);
  margin-bottom: 30px;
}

h2 {
  color: var(--cyan);
  margin-top: 30px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.card {
  background: var(--card);
  padding: 20px;
  border: 1px solid #30304c;
  border-radius: 16px;
  transition: transform 0.25s, border-color 0.25s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--pink);
}

.icon { font-size: 34px; }

.card h3 {
  color: var(--pink);
  margin: 8px 0;
}

.card p {
  color: var(--muted);
  font-size: 14px;
}

.button {
  display: inline-block;
  margin-top: 10px;
  padding: 10px 15px;
  border-radius: 9px;
  background: linear-gradient(90deg, var(--pink), var(--blue));
  color: white;
  text-decoration: none;
  font-weight: bold;
  border: none;
  cursor: pointer;
}

.button:hover { opacity: 0.85; }

.resource-section {
  margin-top: 38px;
  scroll-margin-top: 20px;
}

.resource {
  background: var(--card);
  border: 1px solid #30304c;
  border-radius: 12px;
  padding: 16px;
  margin: 12px 0;
}

.resource h3 {
  color: var(--pink);
  margin-top: 0;
}

.empty {
  color: var(--muted);
  font-style: italic;
}

footer {
  text-align: center;
  padding: 30px 15px;
  margin-top: 40px;
  border-top: 1px solid #30304c;
  color: var(--muted);
}

footer a {
  color: var(--cyan);
  text-decoration: none;
}
</style>
</head>

