
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Grade 9 ICT learning resources: textbooks, PDF materials, notes, presentations, videos, quizzes and exams.">
<title>Grade 9 ICT | Smart Generation Tutor</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #0b0b18;
  color: #fff;
  line-height: 1.6;
}

header {
  background: linear-gradient(135deg, #171738, #29245c);
  padding: 30px 18px;
  text-align: center;
  border-bottom: 2px solid #8187ff;
}

header h1 {
  color: #65eee4;
  font-size: 28px;
  margin-bottom: 8px;
}

header p {
  color: #ddd;
}

.back {
  display: inline-block;
  margin-top: 16px;
  padding: 9px 18px;
  border: 1px solid #65eee4;
  border-radius: 8px;
  color: #65eee4;
  text-decoration: none;
}

.container {
  max-width: 1050px;
  margin: auto;
  padding: 25px 16px;
}

.intro {
  text-align: center;
  margin-bottom: 25px;
}

.intro h2 {
  color: #ff55c8;
  margin-bottom: 8px;
}

.intro p {
  color: #ccc;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 17px;
}

.card {
  background: #17172c;
  border: 1px solid #33335a;
  border-radius: 14px;
  padding: 22px;
  cursor: pointer;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: #65eee4;
  box-shadow: 0 5px 20px #65eee422;
}

.card .icon {
  font-size: 32px;
  margin-bottom: 10px;
}

.card h3 {
  color: #65eee4;
  margin-bottom: 7px;
}

.card p {
  color: #bbb;
  font-size: 14px;
}

.card button {
  margin-top: 14px;
  width: 100%;
  padding: 10px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(90deg, #ff55c8, #8187ff);
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.section {
  display: none;
  background: #17172c;
  border: 1px solid #41416b;
  border-radius: 14px;
  padding: 22px;
  margin-top: 25px;
}

.section.active {
  display: block;
}

.section h2 {
  color: #65eee4;
  margin-bottom: 12px;
}

.material {
  background: #242440;
  border-radius: 9px;
  padding: 14px;
  margin-top: 12px;
}

.material h3 {
  color: #ff55c8;
  font-size: 16px;
}

.material p {
  color: #ccc;
  font-size: 14px;
}

.empty {
  color: #aaa;
  padding: 15px;
  border: 1px dashed #555;
  border-radius: 9px;
  margin-top: 12px;
}

.close {
  margin-top: 18px;
  background: #ff55c8;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 8px;
  cursor: pointer;
}

footer {
  text-align: center;
  padding: 25px 15px;
  color: #aaa;
  border-top: 1px solid #333;
  margin-top: 35px;
  font-size: 13px;
}

@media(max-width: 500px) {
  header h1 {
    font-size: 23px;
  }
  .container {
    padding: 18px 12px;
  }
}
</style>
</head>

<body>

<header>
  <h1>Grade 9 ICT</h1>
  <p>Smart Generation Tutor | Learn • Create • Share • Grow</p>

  <a class="back" href="../index.html">← Back to Grade 9</a>
</header>

<main class="container">

  <div class="intro">
    <h2>Information and Communication Technology</h2>
    <p>
      Welcome to Grade 9 ICT! Explore your learning materials,
      develop digital skills, and test your knowledge.
    </p>
  </div>

  <div class="grid">

    <div class="card" onclick="openSection('textbooks')">
      <div class="icon">📚</div>
      <h3>Textbooks</h3>
      <p>Explore ICT textbooks and reference materials.</p>
      <button>Open Textbooks</button>
    </div>

    <div class="card" onclick="openSection('pdf')">
      <div class="icon">📄</div>
      <h3>PDF Materials</h3>
      <p>Study downloadable ICT learning documents.</p>
      <button>Open PDF Materials</button>
    </div>

    <div class="card" onclick="openSection('presentations')">
      <div class="icon">📊</div>
      <h3>PowerPoint</h3>
      <p>Learn through organized visual presentations.</p>
      <button>Open Presentations</button>
    </div>

    <div class="card" onclick="openSection('notes')">
      <div class="icon">📝</div>
      <h3>Short Notes</h3>
      <p>Review important concepts and summaries.</p>
      <button>Open Short Notes</button>
    </div>

    <div class="card" onclick="openSection('videos')">
      <div class="icon">🎥</div>
      <h3>Video Lessons</h3>
      <p>Understand ICT concepts through videos.</p>
      <button>Open Videos</button>
    </div>

    <div class="card" onclick="openSection('audio')">
      <div class="icon">🎧</div>
      <h3>Audio Lessons</h3>
      <p>Listen to educational explanations.</p>
      <button>Open Audio</button>
    </div>

    <div class="card" onclick="openSection('quizzes')">
      <div class="icon">🧠</div>
      <h3>Quizzes</h3>
      <p>Practice questions and check your understanding.</p>
      <button>Open Quizzes</button>
    </div>

    <div class="card" onclick="openSection('exams')">
      <div class="icon">🏆</div>
      <h3>Exams & Assessments</h3>
      <p>Prepare for tests and examinations.</p>
      <button>Open Exams</button>
    </div>

  </div>

  <div id="textbooks" class="section">
    <h2>📚 ICT Textbooks</h2>
    <div class="empty">No textbooks uploaded yet. Learning materials will appear here.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="pdf" class="section">
    <h2>📄 PDF Materials</h2>
    <div class="empty">No PDF materials uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="presentations" class="section">
    <h2>📊 PowerPoint Presentations</h2>
    <div class="empty">No presentations uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="notes" class="section">
    <h2>📝 Short Notes</h2>
    <div class="empty">No short notes uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="videos" class="section">
    <h2>🎥 Video Lessons</h2>
    <div class="empty">No video lessons uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="audio" class="section">
    <h2>🎧 Audio Lessons</h2>
    <div class="empty">No audio lessons uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="quizzes" class="section">
    <h2>🧠 ICT Quizzes</h2>
    <div class="empty">No quizzes uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

  <div id="exams" class="section">
    <h2>🏆 Exams and Assessments</h2>
    <div class="empty">No exams uploaded yet.</div>
    <button class="close" onclick="closeSections()">Close Section</button>
  </div>

</main>

<footer>
  <p>© 2026 Gidy Nega | Smart Generation Tutor</p>
  <p>Learn • Create • Share • Grow 💪</p>
</footer>

<script>
function openSection(id) {
  closeSections();

  const section = document.getElementById(id);

  if (section) {
    section.classList.add("active");

    section.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }
}

function closeSections() {
  document.querySelectorAll(".section").forEach(section => {
    section.classList.remove("active");
  });
}
</script>

</body>
</html>
